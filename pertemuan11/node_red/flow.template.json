    "acceptsClientConfig": [
      "ui-control",
      "ui-notification"
    ],
    "showPathInSidebar": false,
    "headerContent": "page",
    "navigationStyle": "none",
    "titleBarStyle": "default",
    "allowInstall": false
  },
