        "p11insert"
      ]
    ]
  },
  {
    "id": "p11insert",
    "type": "sqlite",
    "name": "Simpan pengamatan",
    "mydb": "p11db",
    "sqlquery": "prepared",
    "sql": "INSERT INTO pengamatan(waktu,suhu,kelembapan,led) VALUES ($waktu,$suhu,$kelembapan,$led)",
    "z": "p11tab",
    "x": 1020,
    "y": 400,
    "wires": [
      [
        "p11count"
      ]
    ]
  },
  {
    "id": "p11count",
    "type": "sqlite",
    "name": "Hitung data tersimpan",
    "mydb": "p11db",
    "sqlquery": "fixed",
    "sql": "SELECT COUNT(*) AS jumlah FROM pengamatan",
    "z": "p11tab",
    "x": 1040,
    "y": 80,
    "wires": [
      [
        "p11countvalue"
      ]
    ]
  },
  {
    "id": "p11countvalue",
    "type": "function",
    "name": "Ambil jumlah",
    "func": "msg.payload = msg.payload[0].jumlah;\nreturn msg;",
    "outputs": 1,
    "z": "p11tab",
    "x": 1250,
    "y": 80,
    "wires": [
      [
        "p11countui"
