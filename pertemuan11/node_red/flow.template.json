[
  {
    "id": "p11tab",
    "type": "tab",
    "label": "Pertemuan 11 - MQTT dan SQLite",
    "disabled": false,
    "info": "Sensor ke dasbor/SQLite; tombol mengirim perintah, status berasal dari ESP32."
  },
  {
    "id": "p11broker",
    "type": "mqtt-broker",
    "name": "Broker latihan",
    "broker": "__BROKER__",
    "port": "__PORT__",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "30",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "p11db",
    "type": "sqlitedb",
    "db": "__DB_FILE__",
    "mode": "RWC"
  },
  {
    "id": "p11ui",
    "type": "ui-base",
    "name": "Praktik MK38",
    "path": "/dashboard",
