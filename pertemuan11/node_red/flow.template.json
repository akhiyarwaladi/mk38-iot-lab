  {
    "id": "p11init",
    "type": "inject",
    "name": "Siapkan tabel",
    "props": [
      {
        "p": "payload"
      }
    ],
    "once": true,
    "onceDelay": 0.2,
    "repeat": "",
    "payload": "",
    "payloadType": "date",
    "z": "p11tab",
    "x": 130,
    "y": 80,
    "wires": [
      [
        "p11create"
      ]
    ]
  },
  {
    "id": "p11create",
    "type": "function",
    "name": "CREATE TABLE",
    "func": "msg.topic = \"CREATE TABLE IF NOT EXISTS pengamatan (id INTEGER PRIMARY KEY AUTOINCREMENT, waktu TEXT NOT NULL, suhu REAL NOT NULL, kelembapan REAL NOT NULL, led INTEGER);\";\nreturn msg;",
    "outputs": 1,
    "z": "p11tab",
    "x": 350,
    "y": 80,
    "wires": [
      [
        "p11schema"
      ]
    ]
  },
  {
    "id": "p11schema",
    "type": "sqlite",
    "name": "Buat tabel jika belum ada",
    "mydb": "p11db",
    "sqlquery": "batch",
    "sql": "",
    "z": "p11tab",
    "x": 550,
    "y": 80,
    "wires": [
      [
        "p11ready"
      ]
    ]
  },
  {
    "id": "p11ready",
    "type": "function",
    "name": "Tabel siap",
    "func": "flow.set(\"dbSiap\", true);\nreturn msg;",
    "outputs": 1,
    "z": "p11tab",
    "x": 780,
    "y": 80,
    "wires": [
      [
        "p11count"
      ]
    ]
  },
  {
    "id": "p11sensor",
    "type": "mqtt in",
    "name": "Data sensor",
    "topic": "__ROOT__/sensor",
    "qos": "0",
