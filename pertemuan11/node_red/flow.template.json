  {
    "id": "p11chart",
    "type": "ui-chart",
    "name": "Riwayat suhu",
    "group": "p11monitor",
    "label": "Perubahan suhu selama sesi",
    "order": 3,
    "width": 6,
    "height": 4,
    "chartType": "line",
    "category": "Suhu",
